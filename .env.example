# Supabase project URL and public anonymous key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for the /admin HTTP Basic Authentication prompt.
# Use long, unique values in Vercel production environment variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Server-only signing secret for KYOSO / MOD session cookies (24+ random characters).
STAFF_SESSION_SECRET=replace-with-at-least-24-random-characters
